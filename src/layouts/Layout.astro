---
import Favicon from '../components/Favicon.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Felix Fong (@felixfong227) personal website" />
        <meta name="viewport" content="width=device-width" />
        <Favicon />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <!-- Preload fonts -->
        <link 
            rel="preload" 
            href="/fonts/oswald-latin-variable-wghtOnly-normal.woff2" 
            as="font" 
            type="font/woff2" 
            crossorigin 
        />
        <link 
            rel="preload" 
            href="/fonts/oxygen-latin-700-normal.woff2" 
            as="font" 
            type="font/woff2" 
            crossorigin 
        />
        <link 
            rel="preload" 
            href="/fonts/krona-one-latin-400-normal.woff2" 
            as="font" 
            type="font/woff2" 
            crossorigin 
        />

        <style is:inline>
            /* Font display strategy */
            @font-face {
                font-family: 'Oswald';
                font-display: swap;
            }
            @font-face {
                font-family: 'Oxygen';
                font-display: swap;
            }
            @font-face {
                font-family: 'Krona One';
                font-display: swap;
            }
        </style>
    </head>
    <body>
        <slot />
    </body>
</html>
