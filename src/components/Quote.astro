---
import "@fontsource/krona-one";

export interface Props {
    endQuote?: boolean;
}
const { endQuote = false } = Astro.props;
---

{
    (endQuote === true) ?
    <span class="h-4 font-krona-one text-4xl leading-10 tracking-wide text-grey">”</span> :
    <span class="h-4 font-krona-one text-4xl leading-10 tracking-wide text-grey">“</span>
}
