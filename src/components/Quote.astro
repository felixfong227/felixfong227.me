---
import '@fontsource/krona-one';

export interface Props {
    endQuote?: boolean;
}
const { endQuote = false } = Astro.props;
---

{
    (endQuote === true) ?
    <span class="font-krona-one leading-10 tracking-wide text-grey">”</span> :
    <span class="font-krona-one leading-10 tracking-wide text-grey">“</span>
}
