---
import Layout from "../layouts/Layout.astro";
import "@fontsource-variable/oswald";
import "@fontsource/oxygen";
import "@fontsource/krona-one";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import localProfilePicture from "../img/profile_picture.jpg";
import localWaveSVG from "../img/wave.svg";

const socialLinks = [
    { name: "github", url: "https://github.com/felixfong227" },
    { name: "linkedin", url: "https://linkedin.com/in/felixfong227" },
];
---

<Layout title="Felix Fong (@felixfong227)">
    <main class="flex flex-col min-h-screen">
        <div
            class="md:bottom-[13%] md:left-8 md:fixed flex justify-center gap-4 mt-8 md:w-1/3"
        >
            {
                socialLinks.map(({ name, url }) => (
                    <a
                        href={url}
                        data-attr={name}
                        aria-label={`Visit my ${name} profile`}
                    >
                        <Icon name={`mdi:${name}`} class="w-10 h-10" />
                    </a>
                ))
            }
        </div>

        <div
            class="flex flex-col items-center md:items-start md:pt-24 md:pl-64"
        >
            <div class="relative">
                <Image
                    src={localProfilePicture}
                    alt="Felix Fong"
                    class="rounded-full w-36 md:w-64 h-36 md:h-64"
                    width={512}
                    height={512}
                    loading="eager"
                />
            </div>
            <h1
                class="md:top-[43%] md:-left-4 md:absolute mt-4 md:mt-0 font-bold font-oswald text-4xl md:text-6xl uppercase tracking-wider md:tracking-widest md:-rotate-90"
            >
                Felix Fong
            </h1>
        </div>

        <div class="md:pt-24 md:pl-64">
            <div class="mb-12 md:mb-8 md:pl-8 text-center md:text-left">
                <p
                    class="font-bold font-oxygen text-xl md:text-2xl tracking-wide"
                >
                    <span
                        class="font-krona-one font-normal text-3xl text-gray-400 leading-relaxed tracking-wide"
                        >"</span
                    >
                    Back End Solution Engineer
                    <span
                        class="font-krona-one font-normal text-3xl text-gray-400 leading-relaxed tracking-wide"
                        >"</span
                    >
                </p>
                <p class="md:pl-12 font-bold font-oxygen text-sm md:text-2xl">
                    Specializing in NodeJS and Go
                </p>
            </div>

            <div class="md:pl-20 text-center md:text-left">
                <p
                    class="font-bold font-oxygen text-sm md:text-2xl tracking-wide"
                >
                    Designing and maintaining large-scale
                </p>
                <p class="md:pl-8 font-bold font-oxygen text-sm md:text-2xl">
                    production application for the real world
                </p>
            </div>
        </div>

        <div class="mt-auto">
            <Image
                src={localWaveSVG}
                alt="Decorative wave"
                class="w-full h-40 object-cover"
                loading="eager"
            />
        </div>
    </main>
</Layout>
