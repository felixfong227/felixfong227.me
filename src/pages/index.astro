---
import Layout from '../layouts/Layout.astro';
import '@fontsource-variable/oswald';
import '@fontsource/oxygen';
import { Image } from 'astro:assets';
import localProfilePicture from '../../img/profile_picture.jpg';
import Quote from '../components/Quote.astro';
import { Icon } from 'astro-icon/components'
---

<Layout title="Felix Fong (@felixfong227)">
    <main class="flex h-screen w-screen flex-col">

        <div class="mt-5 flex flex-row items-center justify-center gap-2">
            <Icon name="mdi:github" class="size-11 p-1">
                <a href="https://github.com/felixfong227" />
            </Icon>

            <Icon name="mdi:linkedin" class="size-11 p-1">
                <a href="https://linkedin.com/in/felixfong227" />
            </Icon>
        </div>

        <div class="mt-10 flex flex-col items-center">
            <Image
                    alt="my profile pic"
                    src={localProfilePicture}
                    loading={'eager'}
                    width={274}
                    height={274}
                    class="mb-6 h-36 w-36 rounded-full"
            />
            <h1 class="font-oswald text-4xl font-bold uppercase" >Felix Fong</h1>
        </div>


        <div class="mt-7 flex w-full flex-col items-center font-oxygen text-sm">

            <div>
                <Quote />
                <span class="text-xl font-bold"> Back End Solution Engineer </span>
                <Quote endQuote={true} />

                <p class="text-center text-sm font-bold">Specializing in NodeJS and Go</p>
            </div>

            <div class="mt-7 text-sm font-bold">
                <p>Designing and maintaining large-scale</p>
                <span class="">production application for the real world</span>
            </div>

        </div>

    </main>
</Layout>
